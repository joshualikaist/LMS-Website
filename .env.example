# Set this to the final custom domain so canonical, Open Graph, JSON-LD, and llms.txt URLs are absolute.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional. Leave unset to keep Morning Digest at /digest on the same site.
# Set this later if you split Digest onto its own subdomain, e.g. https://digest.your-domain.example
# NEXT_PUBLIC_DIGEST_URL=https://digest.your-domain.example
